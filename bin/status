#!/usr/bin/env python3
"""Report Filen mount + account state as JSON for the Omarchy Filen plugin.

This helper is deliberately credential-free and cheap. It only runs local
probes -- the managed binary's presence, the credential blob's presence, the
kernel mount table, ``systemctl --user show``, and ``systemctl --user
is-enabled`` -- plus a merge of the
non-secret API fragment the credentialed status timer writes. It never runs
``filen``, never opens a TTY, and never reads the credential's contents.

Usage:
    status [--mount-root DIR] [--filen-bin PATH] [--credential PATH]
           [--runtime-dir DIR] [--api-max-age SECONDS]
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_MOUNT_ROOT = "~/Filen"
DEFAULT_FILEN_BIN = "~/.local/share/omarchy-filen/bin/filen"
DEFAULT_CREDENTIAL = "~/.config/credstore.encrypted/filen-auth"
MOUNT_UNIT = "omarchy-filen-mount.service"
MOUNTINFO_PATH = "/proc/self/mountinfo"

# The status timer refreshes the API fragment on a slow cadence (default 10
# minutes). Treat anything older than twice that as stale so the panel never
# presents long-dead quota figures as current.
API_MAX_AGE_SECONDS = 1200
PROBE_TIMEOUT_SECONDS = 5

MOUNTINFO_ESCAPE = re.compile(r"\\([0-7]{3})")


def expand(path):
    """Expand ``~`` and return a ``Path``."""
    return Path(os.path.expanduser(str(path)))


def runtime_filen_dir(explicit=None):
    """The tmpfs dir holding runtime state: ``$XDG_RUNTIME_DIR/filen``."""
    if explicit:
        return expand(explicit)
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        try:
            base = "/run/user/%d" % os.getuid()
        except AttributeError:  # pragma: no cover - non-POSIX
            base = "/tmp"
    return Path(base) / "filen"


def run(command, timeout=PROBE_TIMEOUT_SECONDS):
    """Run a non-interactive command; return ``(exit_code, stdout)``."""
    try:
        done = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            errors="replace",
            stdin=subprocess.DEVNULL,
            timeout=timeout,
        )
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 1, ""
    return done.returncode, (done.stdout or "").strip()


def binary_present(path):
    """True when the plugin-managed ``filen`` executable exists."""
    try:
        return os.path.isfile(path) and os.access(path, os.X_OK)
    except OSError:
        return False


def credential_present(path):
    """True when the systemd credential blob exists (contents never read)."""
    try:
        return os.path.isfile(path)
    except OSError:
        return False


def mounted_paths(mountinfo_path=MOUNTINFO_PATH):
    """Every mountpoint currently in the kernel mount table."""
    found = set()
    try:
        # ``errors="replace"``: the kernel can expose non-UTF8 mountpoints, and
        # an unreadable mount table must degrade to "not mounted", not a crash.
        with open(
            mountinfo_path, "r", encoding="utf-8", errors="replace"
        ) as handle:
            for line in handle:
                # ... mountpoint options - fstype source superopts
                left = line.split(" - ", 1)[0].split()
                if len(left) < 5:
                    continue
                # The kernel octal-escapes spaces and a few delimiters; decode
                # only those escapes so valid UTF-8 survives intact.
                found.add(
                    MOUNTINFO_ESCAPE.sub(
                        lambda match: chr(int(match.group(1), 8)), left[4]
                    )
                )
    except (OSError, ValueError):
        return set()
    return found


def is_mounted(mount_path, mountinfo_path=MOUNTINFO_PATH):
    """True when ``mount_path`` is an active mountpoint."""
    try:
        target = os.path.realpath(str(mount_path))
        for point in mounted_paths(mountinfo_path):
            if os.path.realpath(point) == target:
                return True
    except (OSError, ValueError):
        return False
    return False


def unit_state(unit=MOUNT_UNIT):
    """The unit's ``ActiveState`` (``active``/``inactive``/``failed``/...)."""
    code, out = run(
        ["systemctl", "--user", "show", unit, "--property=ActiveState"]
    )
    if code != 0 and not out:
        return "inactive"
    state = "inactive"
    for line in out.splitlines():
        if line.startswith("ActiveState="):
            state = line.partition("=")[2].strip() or "inactive"
            break
    return state


def auto_mount_enabled(unit=MOUNT_UNIT):
    """True when the mount unit is enabled to start at login.

    ``is-enabled`` exits non-zero for a disabled, masked, or absent unit and
    prints the state otherwise. Only a literal ``enabled`` counts as autostart;
    a missing unit is not an error here.
    """
    code, out = run(["systemctl", "--user", "is-enabled", unit])
    if code != 0 or not out:
        return False
    return out.splitlines()[0].strip() == "enabled"


def read_fragment(path):
    """Parse the non-secret API fragment; ``None`` when absent/unreadable."""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _as_int(value, default=0):
    """Coerce to int; malformed, infinite, or huge-impossible values fall back."""
    if isinstance(value, bool):
        return default
    try:
        return int(value)
    except (TypeError, ValueError, OverflowError):
        return default


def _as_float(value):
    """Coerce to a finite float, or ``None`` when it cannot be represented."""
    if isinstance(value, bool):
        return None
    try:
        result = float(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return result if math.isfinite(result) else None


def _as_epoch(value):
    """Coerce a fragment timestamp to epoch seconds, or ``None``."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)) and value > 0:
        try:
            return int(value)
        except (ValueError, OverflowError):
            return None
    return None


def fragment_is_fresh(fragment, now, api_max_age=API_MAX_AGE_SECONDS):
    """True when the fragment carries a recent, parseable ``checkedAt``.

    ``ok`` is deliberately ignored: an auth-rejected probe writes ``ok: false``
    together with ``authenticated: false``, and that is exactly the signal H07
    must act on.
    """
    if not isinstance(fragment, dict):
        return False
    checked = _as_epoch(fragment.get("checkedAt"))
    if checked is None:
        return False
    if api_max_age and api_max_age > 0 and now - checked > api_max_age:
        return False
    return True


def resolve_authenticated(
    blob_present, fragment, now, api_max_age=API_MAX_AGE_SECONDS
):
    """H07: a *fresh* fragment may veto the credential blob's presence.

    ``credential_blob_present AND (fresh fragment ? authenticated !== false :
    true)``. A stale/absent fragment or a network-error fragment (no
    ``authenticated`` field) never turns a present blob into ``needs-auth``;
    offline is not the same as a rejected credential.
    """
    if not blob_present:
        return False
    if (
        fragment_is_fresh(fragment, now, api_max_age)
        and fragment.get("authenticated") is False
    ):
        return False
    return True


def unknown_api(now):
    """The API fields when there is no usable fragment."""
    return {
        "usedBytes": 0,
        "quotaBytes": 0,
        "usagePercent": 0.0,
        "quotaKnown": False,
        "files": [],
        "checkedAt": now,
    }


def _clean_files(raw):
    if not isinstance(raw, list):
        return []
    rows = []
    for item in raw:
        if not isinstance(item, dict):
            continue
        rows.append(
            {
                "name": str(item.get("name", "")),
                "path": str(item.get("path", "")),
                "folder": str(item.get("folder", "")),
                "modifiedTs": _as_int(item.get("modifiedTs")),
                "sizeBytes": _as_int(item.get("sizeBytes")),
            }
        )
    return rows


def merge_fragment(fragment, now, api_max_age=API_MAX_AGE_SECONDS):
    """Merge the API fragment, dropping it when missing/stale/unusable.

    A dropped fragment still surfaces its own ``checkedAt`` so the panel can
    annotate how old the cached quota is; a missing one falls back to the
    helper's probe time.
    """
    if not isinstance(fragment, dict):
        return unknown_api(now)

    checked = _as_epoch(fragment.get("checkedAt"))

    # ``ok: false`` is the timer reporting a failed probe (offline, auth
    # rejected, ...). There is no quota to merge, but a timestamp it did manage
    # to write is still worth surfacing so the panel can age the cache. A
    # fragment with no parseable timestamp falls back to the probe time.
    if fragment.get("ok") is False or checked is None:
        unknown = unknown_api(now)
        if checked is not None:
            unknown["checkedAt"] = checked
        return unknown

    if api_max_age and api_max_age > 0 and now - checked > api_max_age:
        stale = unknown_api(now)
        stale["checkedAt"] = checked
        return stale

    used = max(0, _as_int(fragment.get("usedBytes")))
    quota = max(0, _as_int(fragment.get("quotaBytes")))
    quota_known = bool(fragment.get("quotaKnown", quota > 0))

    given_percent = _as_float(fragment.get("usagePercent"))
    used_float = _as_float(used)
    quota_float = _as_float(quota)
    if quota_known and given_percent is not None:
        usage_percent = given_percent
    elif quota_known and quota_float and quota_float > 0 and used_float is not None:
        usage_percent = used_float / quota_float * 100.0
    else:
        usage_percent = 0.0

    return {
        "usedBytes": used,
        "quotaBytes": quota,
        "usagePercent": min(100.0, max(0.0, usage_percent)),
        "quotaKnown": quota_known,
        "files": _clean_files(fragment.get("files")),
        "checkedAt": checked,
    }


def build_status(
    mount_root,
    filen_bin,
    credential,
    runtime_dir,
    api_max_age=API_MAX_AGE_SECONDS,
    now=None,
    mountinfo_path=MOUNTINFO_PATH,
    auto_mount=False,
):
    """Assemble the credential-free status contract document."""
    now = int(now if now is not None else time.time())

    installed = binary_present(filen_bin)
    blob_present = credential_present(credential)
    fragment = read_fragment(Path(runtime_dir) / "api-status.json")
    authenticated = resolve_authenticated(blob_present, fragment, now, api_max_age)
    state = unit_state()
    running = is_mounted(mount_root, mountinfo_path=mountinfo_path) or state == "active"

    # A rejected credential is ``needs-auth``, not generic ``failed``: surface it
    # ahead of the unit's own state so the panel offers re-provisioning (H07).
    if not installed:
        status_text = "Not installed"
    elif not authenticated:
        status_text = "Sign-in needed"
    elif state == "failed":
        status_text = "Failed"
    elif running:
        status_text = "Mounted"
    else:
        status_text = "Stopped"

    # Offline is not failure: a stale/missing fragment keeps the local fields,
    # drops the API fields to "unknown", and preserves the fragment's own
    # ``checkedAt`` so the panel can show the cache aging (H08).
    if installed and authenticated:
        api = merge_fragment(fragment, now, api_max_age)
    else:
        api = unknown_api(now)

    return {
        "ok": True,
        "installed": installed,
        "authenticated": authenticated,
        "running": running,
        "statusText": status_text,
        "mountPath": str(mount_root),
        "unitState": state,
        "autoMount": bool(auto_mount),
        "plan": None,
        "usedBytes": api["usedBytes"],
        "quotaBytes": api["quotaBytes"],
        "usagePercent": api["usagePercent"],
        "quotaKnown": api["quotaKnown"],
        "files": api["files"],
        "checkedAt": api["checkedAt"],
    }


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Emit Filen mount/status JSON for the Omarchy panel."
    )
    parser.add_argument("--mount-root", default=DEFAULT_MOUNT_ROOT)
    parser.add_argument("--filen-bin", default=DEFAULT_FILEN_BIN)
    parser.add_argument("--credential", default=DEFAULT_CREDENTIAL)
    parser.add_argument(
        "--runtime-dir",
        default=None,
        help="Override $XDG_RUNTIME_DIR/filen (the API fragment's directory).",
    )
    parser.add_argument(
        "--api-max-age",
        type=int,
        default=API_MAX_AGE_SECONDS,
        help="Discard the API fragment when older than this many seconds.",
    )
    return parser.parse_args(argv)


def collect(argv=None):
    args = parse_args(argv)
    return build_status(
        expand(args.mount_root),
        expand(args.filen_bin),
        expand(args.credential),
        runtime_filen_dir(args.runtime_dir),
        args.api_max_age,
        auto_mount=auto_mount_enabled(),
    )


def main(argv=None):
    """Print exactly one JSON object and always exit 0 (the panel needs JSON)."""
    try:
        status = collect(argv)
    except SystemExit as exc:
        # ``--help`` exits cleanly after printing its own text; a bad flag is a
        # failure the panel must still receive as JSON.
        if exc.code in (0, None):
            return 0
        status = {
            "ok": False,
            "error": "invalid arguments",
            "checkedAt": int(time.time()),
        }
    except BaseException as exc:  # noqa: BLE001 - the panel needs JSON, always
        status = {
            "ok": False,
            "error": str(exc)[:300],
            "checkedAt": int(time.time()),
        }
    try:
        # ``allow_nan=False``: non-finite floats are not valid JSON. If one ever
        # slips through, fall back to a well-formed failure document rather than
        # emitting something the panel cannot parse.
        text = json.dumps(status, allow_nan=False)
    except (TypeError, ValueError):
        text = json.dumps(
            {
                "ok": False,
                "error": "internal error",
                "checkedAt": int(time.time()),
            }
        )
    print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
